	"nodes":[
		{"id":"ac2da79148eef302","type":"text","text":"[GitHub link](https://github.com/sinedka/aniparser)\n[AUR link](https://aur.archlinux.org/packages/aniparser)","x":-376,"y":-256,"width":196,"height":56,"color":"5"},
		{"id":"f46e25d3eee769f8","type":"text","text":"``` dataviewjs\n// Настройки\nconst GITHUB_URL = 'https://raw.githubusercontent.com/sinedka/aniparser/master/README.md';\nconst CACHE_DURATION = 1 * 60 * 1000; // 5 минут в миллисекундах\nconst CACHE_KEY = 'github_cache_vscode_readme';\n\n// Функция загрузки с GitHub\nasync function fetchFromGitHub(url) {\n    try {\n        console.log(`🔄 Загружаем: ${url}`);\n        const response = await fetch(url);\n        \n        if (!response.ok) {\n            throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n        }\n        \n        const content = await response.text();\n        console.log(`✅ Загружено ${content.length} символов`);\n        return content;\n        \n    } catch (error) {\n        console.error('❌ Ошибка загрузки:', error);\n        return `## ❌ Ошибка загрузки\\n\\n**URL**: ${url}\\n**Ошибка**: ${error.message}`;\n    }\n}\n\n// Управление кэшем\nfunction getFromCache(key) {\n    const cached = window[key];\n    if (!cached) return null;\n    \n    const now = Date.now();\n    if (now - cached.timestamp > CACHE_DURATION) {\n        console.log('⏰ Кэш устарел, нужно обновить');\n        return null;\n    }\n    \n    console.log('📋 Используем кэш');\n    return cached;\n}\n\nfunction saveToCache(key, content) {\n    window[key] = {\n        content: content,\n        timestamp: Date.now()\n    };\n    console.log('💾 Контент сохранен в кэш');\n}\n\n// Основная логика\nconst cached = getFromCache(CACHE_KEY);\n\nif (cached) {\n    // Отображаем контент как Markdown\n    dv.paragraph(cached.content);\n\t\n\tdv.paragraph(\"---\");\n\t\n    // Используем кэшированную версию\n    const lastUpdate = new Date(cached.timestamp).toLocaleString('ru-RU');\n    \n    dv.paragraph(`**📅 Последнее обновление**: ${lastUpdate}`);\n    dv.paragraph(`**🔗 Источник**: [${GITHUB_URL}](${GITHUB_URL})`);\n    dv.paragraph(`**⏱️ Следующее обновление**: через ${Math.ceil((CACHE_DURATION - (Date.now() - cached.timestamp)) / 60000)} мин.`);\n    \n} else {\n    // Нужно загрузить новый контент\n    dv.paragraph(\"🔄 **Загружаем свежий контент с GitHub...**\");\n    \n    fetchFromGitHub(GITHUB_URL).then(content => {\n        saveToCache(CACHE_KEY, content);\n        \n        // Обновляем отображение\n        setTimeout(() => {\n            // Dataview автоматически перерисует блок\n            app.workspace.trigger('dataview:refresh-views');\n        }, 100);\n    });\n}\n```\n","x":20,"y":-768,"width":1040,"height":1080,"color":"3"}
	],
